# Copy to .env.local (git-ignored) for `make dev-frontend`. Server-only: never prefix these with
# NEXT_PUBLIC_, which writes a value into the browser bundle.

# Where the backend is. The /api proxy and serverApi() read it on every request, so one build
# runs in any environment.
API_BASE_URL=http://127.0.0.1:8000

# Development only: the user the backend sees (its X-Dev-User header) until real sign-in replaces
# backendCredentials in src/lib/auth.ts. Ignored in production builds.
DEV_USER=dev-user

# Origins the browser may call besides this site (space-separated), added to the CSP's connect-src:
# the object store when the browser uploads to presigned URLs, e.g.
# https://<account>.r2.cloudflarestorage.com. Locally that's RustFS on port 9000.
CSP_CONNECT_SRC=http://127.0.0.1:9000

# OpenTelemetry (src/instrumentation.ts): nothing is set up until an endpoint is set. Traces go
# over HTTP/protobuf to <endpoint>/v1/traces; the backend's settings use the same names.
# OTEL_SERVICE_NAME=web
# OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example.com
# OTEL_EXPORTER_OTLP_HEADERS=api-key=...
