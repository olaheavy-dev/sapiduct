# Every backend setting with a safe local value. Copy to backend/.env (git ignores it) to change one.
APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=false
# DOCS_ENABLED=true
# Largest request body the API reads, in bytes (files go to storage directly).
MAX_REQUEST_BYTES=1048576
# The local database from `make db-up`; production sets its own.
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
# Host port for `make db-up` (change the port in DATABASE_URL to match).
# DB_PORT=5432
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Server-side limits per connection, in milliseconds.
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
# Browser origins allowed to call the API (JSON list); empty means none.
# CORS_ORIGINS=["http://localhost:3000"]
# Host headers the API answers to (JSON list); ["*"] accepts any.
# ALLOWED_HOSTS=["api.example.com"]

# Object storage (S3 API). Leave STORAGE_BUCKET unset for no storage. These values match the local
# RustFS from `make storage-up`; on R2 use https://<account id>.r2.cloudflarestorage.com, region
# auto and an R2 API token's keys.
STORAGE_BUCKET=app
STORAGE_ENDPOINT_URL=http://localhost:9000
# Where browsers reach the storage, if not STORAGE_ENDPOINT_URL (the compose api sets it).
# STORAGE_PUBLIC_ENDPOINT_URL=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=app-storage
STORAGE_SECRET_ACCESS_KEY=app-storage-secret
STORAGE_URL_SECONDS=900
# Largest presigned upload in bytes, and the content types uploads may declare (JSON list).
STORAGE_MAX_UPLOAD_BYTES=26214400
# STORAGE_UPLOAD_TYPES=["image/png","image/jpeg","application/pdf"]
# Host ports for `make storage-up` (change the port in STORAGE_ENDPOINT_URL to match).
# STORAGE_PORT=9000
# STORAGE_CONSOLE_PORT=9001

# The model gateway (backend/src/app/llm/). The model's prices must be in app/llm/prices.py.
LLM_MODEL=openai:gpt-6-luna
# The key for LLM_MODEL's provider; without it, model calls get a 503. Recording (make record-llm)
# and evals (make eval) read it from the environment too.
# OPENAI_API_KEY=
# The embedding model gateway.embeddings() calls (OpenAI only, so it needs OPENAI_API_KEY even when
# LLM_MODEL is Anthropic's); priced in app/llm/prices.py EMBEDDING_PRICES.
EMBEDDING_MODEL=openai:text-embedding-3-small
# ANTHROPIC_API_KEY=
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# Model spend per UTC day across every process, in USD.
LLM_DAILY_BUDGET_USD=5
# Each user's share of a day (calls tagged with their id); unset means no per-user cap.
# LLM_USER_DAILY_BUDGET_USD=0.50
# Most steps an agent may take for one request.
AGENT_MAX_STEPS=25
# Connections for agent checkpoints, opened only while agents run.
AGENT_POOL_SIZE=4

# LangSmith tracing of model calls (never on in tests).
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=
# LANGSMITH_ENDPOINT=
LANGSMITH_TRACING_SAMPLING_RATE=1.0
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false
# Tests start their own database with testcontainers, or use this one if set. They wipe it:
# never point it at data you want to keep.
# TEST_DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app_test

# OpenTelemetry (FastAPI's native support plus the llm.* metrics): nothing is exported until these
# are set. HTTP/protobuf collector base URL; traces, metrics and logs go to /v1/traces and so on.
# FASTAPI_OTEL_AUTO_CONFIGURE=true
# OTEL_SERVICE_NAME=backend
# OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example.com
# OTEL_EXPORTER_OTLP_HEADERS=api-key=...

# MCP servers: each collection's endpoint is MCP_PATH_PREFIX/<public id>. Browsers are refused
# unless their origin is listed; clients with no Origin header (desktop assistants) are not.
# MCP_PATH_PREFIX=/mcp
# MCP_ALLOWED_ORIGINS=["https://app.example.com"]
# MCP_RATE_PER_MINUTE=60
# MCP_RATE_PER_DAY=10000
# MCP_ROTATION_OVERLAP_SECONDS=3600
# MCP_SEARCH_DEFAULT=5
# MCP_SEARCH_MAX=10
# MCP_LIST_DEFAULT=10
# MCP_LIST_MAX=25
# MCP_DOCUMENT_MAX_CHARS=20000
